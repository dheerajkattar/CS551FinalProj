[Unit]
Description=LLM FAQ Bot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_WORKDIR__
EnvironmentFile=__APP_WORKDIR__/.env
ExecStart=/bin/bash -lc '__APP_WORKDIR__/.venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT:-5003} --workers ${UVICORN_WORKERS:-2}'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
